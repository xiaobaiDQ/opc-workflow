# Orca 多 Worktree 环境配置示例
# 新建 Worktree 后运行 `make worktree-init` 或 `./scripts/run.ps1 worktree-init` 会自动复制为 .env
# 并行启动多个 Worktree 的本地服务时，请错开 BACKEND_PORT / FRONTEND_PORT。

NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=5173

# 数据库：每个 Worktree 必须使用自己专用的库名（如 opc_dev_t004），不得共用。
# 迁移只允许在这类一次性本地库上跑；共享库/生产库的迁移须老板单独确认（见 AGENTS.md 第 3 节）。
# 首次并行前须实测验证两棵树的库与端口互不影响，验证前一律视为共享库（T-001 负责验证）。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opc_dev_CHANGE_ME?schema=public
JWT_SECRET=replace-with-local-dev-secret
