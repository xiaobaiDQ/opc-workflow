# Orca 多 Worktree 环境配置示例
# 新建 Worktree 后运行 `make worktree-init` 或 `./scripts/run.ps1 worktree-init` 会自动复制为 .env
# 并行启动多个 Worktree 的本地服务时，请按需错开 BACKEND_PORT / FRONTEND_PORT，避免端口冲突

NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=5173

# 建议多个 Worktree 共享同一个本地 Postgres 容器实例，按需区分库名或 schema
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opc_dev?schema=public
JWT_SECRET=replace-with-local-dev-secret
